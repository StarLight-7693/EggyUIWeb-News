<% if (page.total > 1) { %>
<nav class="pagination" role="navigation">
  <% if (page.prev) { %><a class="page-btn" href="<%- url_for(page.prev_link) %>">← 上一页</a><% } %>
  <span class="page-info"><%= page.current %> / <%= page.total %></span>
  <% if (page.next) { %><a class="page-btn" href="<%- url_for(page.next_link) %>">下一页 →</a><% } %>
</nav>
<% } %>
