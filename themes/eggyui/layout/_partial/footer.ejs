<%
  var main = String(theme.main_url || '').replace(/\/+$/, '')
  var news = String(theme.news_url || '').replace(/\/+$/, '')
%>
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="brand-text"><%= theme.brand || 'EggyUI' %></span>
      <span class="footer-copy">2026 EggyUI Team · Powered by Hexo</span>
    </div>
    <div class="footer-links">
      <!-- 使用target="_self"来实现无缝跳转 -->
      <a href="<%- main + '/' %>" target="_self">主站首页</a>
      <a href="<%- main + '/download' %>" target="_self">下载</a>
      <a href="/" target="_self">新闻</a>
      <a href="<%- main + '/about' %>" target="_self">关于</a>
    </div>
    <div class="footer-ext">
      <% if (theme.sociallinks) { %>
        <% Object.keys(theme.sociallinks).forEach(function(key) { %>
          <a href="<%- url_for(theme.sociallinks[key]) %>" target="_blank"><%= key %></a>
        <% }) %>
      <% } %>
    </div>
  </div>
</footer>
