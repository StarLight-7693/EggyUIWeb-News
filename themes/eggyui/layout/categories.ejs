<%
  var items = site.categories || []
  function each(cb) {
    if (items && typeof items.each === 'function') items.each(cb)
    else if (Array.isArray(items)) items.forEach(cb)
  }
%>
<div class="page news-home">
  <div class="container">
    <div class="list-utils">
      <h1 class="list-title">分类</h1>
      <nav class="chips">
        <a class="chip" href="<%- url_for('archives/') %>" target="_self">归档</a>
        <a class="chip" href="<%- url_for('categories/') %>" target="_self">分类</a>
        <a class="chip" href="<%- url_for('tags/') %>" target="_self">标签</a>
        <a class="chip" href="<%- url_for('atom.xml') %>" target="_blank">RSS</a>
      </nav>
    </div>
    <div class="chip-cloud">
      <% each(function (item) { %>
        <a class="cloud-chip" href="<%- url_for(item.path) %>">
          <span class="cloud-name"><%= item.name %></span>
          <span class="cloud-count"><%= item.posts.length %></span>
        </a>
      <% }) %>
    </div>
  </div>
</div>
