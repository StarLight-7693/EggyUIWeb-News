<div class="page news-home">
  <div class="container">
    <div class="list-utils">
      <h1 class="list-title">搜索</h1>
    </div>
    <form class="search-form big" action="<%- url_for('search/') %>" method="get" role="search">
      <span class="search-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </span>
      <input type="search" name="q" id="searchPageInput" placeholder="搜索新闻标题与正文..." autocomplete="off" />
      <button type="submit" class="btn btn-primary">搜索</button>
    </form>
    <div id="searchStats" class="search-tip"></div>
    <div id="searchResults" class="card-grid"></div>
  </div>
</div>
<script src="<%- url_for('js/search.js') %>"></script>
